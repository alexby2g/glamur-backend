APP_NAME="AUREA Beauty"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://TU-BACKEND.onrender.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=TU_HOST_POSTGRES
DB_PORT=5432
DB_DATABASE=TU_BASE_DE_DATOS
DB_USERNAME=TU_USUARIO
DB_PASSWORD=TU_CONTRASENA_SEGURA

# Dominios web autorizados, separados por coma y sin barra final.
# La app móvil nativa no depende de CORS.
CORS_ALLOWED_ORIGINS=https://glamur-frontend.vercel.app

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Vigencia máxima de los tokens API (1 a 90 días).
SESSION_LIFETIME_DAYS=30

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hola@example.com
MAIL_FROM_NAME="AUREA Beauty"

ADMIN_REGISTER_CODE=CAMBIA_ESTE_CODIGO_LARGO_Y_ALEATORIO
